#: ui/main.qml:21
#, kde-format
msgid "Enable the KDE wallet subsystem"
msgstr "Activer le sous-système de portefeuilles de KDE"

#: ui/main.qml:63
#, kde-format
msgctxt "@title:group"
msgid "Close Behavior"
msgstr "Fermer le comportement"

#: ui/main.qml:72
#, kde-format
msgid "Close wallet when unused for:"
msgstr "Fermer le portefeuille si inutilisé pendant : "

#: ui/main.qml:88
#, kde-format
msgctxt "short for minute(s)"
msgid "%1 min"
msgid_plural "%1 min"
msgstr[0] "%1 min"
msgstr[1] "%1 min"

#: ui/main.qml:91
#, kde-format
msgctxt "short for minute(s)"
msgid "min"
msgstr "min"

#: ui/main.qml:108
#, kde-format
msgctxt "@title:group"
msgid "Automatic Wallet Selection"
msgstr "Sélection automatique du portefeuille"

#: ui/main.qml:111
#, kde-format
msgid "Default Wallet:"
msgstr "Portefeuille par défaut :"

#: ui/main.qml:133 ui/main.qml:192
#, kde-format
msgid "New…"
msgstr "Nouveau…"

#: ui/main.qml:146
#, kde-format
msgid "Use different default wallet for local passwords"
msgstr ""
"Utiliser par défaut un portefeuille spécifique pour les mots de passe locaux"

#: ui/main.qml:204
#, kde-format
msgctxt "@title:group"
msgid "Wallet Manager"
msgstr "Gestionnaire de portefeuilles"

#: ui/main.qml:209
#, kde-format
msgid "Show icon in system tray"
msgstr "Afficher une icône dans la boite à miniatures"

#: ui/main.qml:222
#, kde-format
msgid "Hide system tray icon when last wallet closes"
msgstr ""
"Masquer l'icône de la boite à miniatures lorsque le dernier portefeuille est "
"fermé"

#: ui/main.qml:236
#, kde-format
msgctxt "@title:group"
msgid "Secret Service"
msgstr "Services d'accès aux données confidentielles"

#: ui/main.qml:240
#, kde-format
msgid "Use KWallet for Secret Service Interface"
msgstr ""
"Utiliser KWallet pour l'interface des services d'accès aux données "
"confidentielles"

#: ui/NewWalletDialog.qml:12
#, kde-format
msgid "New Wallet"
msgstr "Nouveau portefeuille"

#: ui/NewWalletDialog.qml:23
#, kde-format
msgid "Choose a name for the new wallet:"
msgstr "Veuillez sélectionner un nom pour le nouveau portefeuille :"

#~ msgctxt "NAME OF TRANSLATORS"
#~ msgid "Your names"
#~ msgstr "Robert Jacolin, Bruno Patri"

#~ msgctxt "EMAIL OF TRANSLATORS"
#~ msgid "Your emails"
#~ msgstr "rjacolin@ifrance.com, bruno.patri@gmail.com"

#~ msgid "Permission denied."
#~ msgstr "Permission refusée."

#~ msgid "KDE Wallet Control Module"
#~ msgstr "Module de configuration des portefeuilles de KDE"

#~ msgid "Wallet Preferences"
#~ msgstr "Préférences des portefeuilles de KDE"

#~ msgid ""
#~ "<p>The wallet subsystem provides a convenient and secure way to manage "
#~ "all your passwords. This option specifies whether or not you want to use "
#~ "it.</p>"
#~ msgstr ""
#~ "<p>Le sous-système de portefeuilles fournit une façon pratique et sûre de "
#~ "gérer tous vos mots de passe. Vous pouvez décider d'utiliser ou non ce "
#~ "système grâce à cette option.</p>"

#~ msgid ""
#~ "It is best to close your wallets when you are not using them to prevent "
#~ "others from viewing or using them."
#~ msgstr ""
#~ "Il est judicieux de fermer vos portefeuilles lorsque vous ne les utilisez "
#~ "plus afin que personne ne puisse les regarder ou les utiliser."

#~ msgid "Close wallet:"
#~ msgstr "Fermeture du portefeuille :"

#~ msgid ""
#~ "<p><b>Close wallet as soon as applications that use it have stopped.</"
#~ "b><br>Note that your wallet will only be closed when all applications "
#~ "that use it have stopped.<br>When a wallet is closed the password is "
#~ "needed to access it again.</p>"
#~ msgstr ""
#~ "<p><b>Fermer le portefeuille dès que les applications qui l'utilisent "
#~ "s'arrêtent.</b><br />Veuillez noter que vos portefeuilles seront fermés "
#~ "uniquement lorsque toutes les applications qui l'utilisent se seront "
#~ "arrêtées.<br />Lorsqu'un portefeuille est fermé, le mot de passe est "
#~ "nécessaire pour y accéder à nouveau.</p>"

#~ msgid "When last application stops using it"
#~ msgstr "Lorsque la dernière application arrête de l'utiliser"

#~ msgid ""
#~ "<p><b>Close wallet after a period of inactivity.</b><br>When a wallet is "
#~ "closed the password is needed to access it again.</p>"
#~ msgstr ""
#~ "<p><b>Ferme un portefeuille après une période d'inactivité</b><br /> Une "
#~ "fois un portefeuille fermé, le mot de passe est nécessaire pour y accéder "
#~ "à nouveau.</p>"

#~ msgid " minutes"
#~ msgstr " minutes"

#~ msgid "New..."
#~ msgstr "Nouveau…"

#~ msgid ""
#~ "The Secret Service interface lets applications store passwords and other "
#~ "confidential data. Disable this to allow third-party wallet services such "
#~ "as KeePassXC or GNOME Keyring to manage it instead."
#~ msgstr ""
#~ "L'interface pour les services d'accès aux données confidentielles permet "
#~ "aux applications d'enregistrer des mots de passe et d'autres données "
#~ "confidentielles. Désactivez cette option pour permettre aux services de "
#~ "portefeuille tiers tels que « KeePassXC » ou « GNOME Keyring » de la "
#~ "gérer à la place."

#~ msgid "&Launch Wallet Manager"
#~ msgstr "&Lancer le gestionnaire de portefeuilles de KDE"

#~ msgid "Always Allow"
#~ msgstr "Toujours accepter"

#~ msgid "Always Deny"
#~ msgstr "Toujours refuser"

#~ msgid "&Delete"
#~ msgstr "&Supprimer"

#~ msgid "Access Control"
#~ msgstr "Contrôle d'accès"

#~ msgid "&Prompt when an application accesses a wallet"
#~ msgstr ""
#~ "&Demander une confirmation lorsqu'une application accède à un portefeuille"

#~ msgid "Wallet"
#~ msgstr "Portefeuille"

#~ msgid "Application"
#~ msgstr "Application"

#~ msgid "Policy"
#~ msgstr "Politique"

#~ msgid ""
#~ "<p><b>Close wallet as soon as the screensaver starts.</b><br>When a "
#~ "wallet is closed the password is needed to access it again.</p>"
#~ msgstr ""
#~ "<p><b>Fermer le portefeuille dès que l'économiseur d'écran démarre.</"
#~ "b><br>Lorsqu'un portefeuille est fermé, le mot de passe est nécessaire "
#~ "pour y accéder à nouveau.</p>"

#~ msgid "When screensaver starts"
#~ msgstr "Lorsque l'économiseur d'écran démarre"

